# Copy this file to .env and fill in real values. Never commit .env.

# Local model server. No API key is needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Where SQLite lives on disk. Defaults to ./tigtagtoe.db
DATABASE_URL=sqlite:///./tigtagtoe.db

# Comma-separated origins the API will accept. In dev this is the Vite URL.
CORS_ORIGINS=http://localhost:5173

# Max emails the agent will process in a single run. Safety cap.
MAX_EMAILS_PER_RUN=300

# How many emails to send to the model concurrently. Start at 1 for local inference.
AGENT_CONCURRENCY=1

# Cap the body length sent to the model (in characters).
MAX_BODY_CHARS=4000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Public demo (default frontend): deployed Cloudflare Worker HTTPS URL.
VITE_TRIAGE_API_URL=
# Set true only for the original local CSV / FastAPI / Ollama application.
VITE_LOCAL_BACKEND=false
